+static int ov5640_mod_reg(u16 reg,
+              u8 mask, u8 val)
+{
+    u8 readval;
+    int ret;
+
+    ret = ov5640_read_reg( reg, &readval);
+    if (ret < 0)
+        return ret;
+
+    readval &= ~mask;
+    val &= mask;
+    val |= readval;
+
+    return ov5640_write_reg(reg, val);
+}
