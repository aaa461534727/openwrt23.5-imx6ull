+static inline void ov5640_power_down(struct ov5640 *sensor, int enable)
+{
+	if (sensor->pwn_gpio < 0)
+		return;
+
+	if (!enable)
+		gpio_set_value_cansleep(sensor->pwn_gpio, 0);
+	else
+		gpio_set_value_cansleep(sensor->pwn_gpio, 1);
+
+	msleep(2);
+}
