+            64,
+            gcvVIDMEM_TYPE_BITMAP,
+            allocFlag,
+            &patchBufferSizes[i],
+            &pool,
+            &Execution->funcCmd[0].data[i].bufVidMem
+            ));
+
+        gcmkONERROR(gckVIDMEM_NODE_LockCPU(
+            hardware->kernel,
+            Execution->funcCmd[0].data[i].bufVidMem,
