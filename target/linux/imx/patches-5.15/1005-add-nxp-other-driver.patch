+static int vsi_dec_try_fmt(struct file *file, void *prv, struct v4l2_format *f)
+{
+	struct vsi_v4l2_ctx *ctx = fh_to_ctx(file->private_data);
+
+	if (!vsi_v4l2_daemonalive())
+		return -ENODEV;
+
+	vsiv4l2_verifyfmt(ctx, f, 1);
+	vsi_dec_getvui(ctx, f);
+	return 0;
+}
