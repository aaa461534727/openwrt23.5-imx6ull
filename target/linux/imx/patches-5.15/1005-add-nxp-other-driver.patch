+static void precheck_vb_data(struct vpu_ctx *ctx, struct vb2_buffer *vb)
+{
+	unsigned long index;
+
+	if (!ctx || !vb)
+		return;
+
+	index = ctx->q_data[V4L2_SRC].qbuf_count;
+	show_beginning_of_data(index, vb, 0);
+	find_pattern_from_vb(ctx->dev, index, vb, 0);
