+	vpu_enc_mu_enable_rx(core_dev);
+	reg_fw_base = core_dev->reg_csr_base;
+	write_vpu_reg(dev, core_dev->m0_p_fw_space_phy, reg_fw_base + CSR_CM0Px_ADDR_OFFSET);
+	write_vpu_reg(dev, 0x0, reg_fw_base + CSR_CM0Px_CPUWAIT);
