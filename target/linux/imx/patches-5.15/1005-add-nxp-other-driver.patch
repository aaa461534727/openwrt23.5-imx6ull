+static struct vb2_data_req *find_vb2_data_by_sequence(struct queue_data *queue,
+							u32 sequence)
+{
+	int i;
+
+	for (i = 0; i < queue->vb2_q.num_buffers; i++) {
+		if (!queue->vb2_reqs[i].vb2_buf)
+			continue;
+		if (queue->vb2_reqs[i].sequence == sequence)
+			return &queue->vb2_reqs[i];
+	}
