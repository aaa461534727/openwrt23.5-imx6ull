+static u32 get_greatest_common_divisor(u32 a, u32 b)
+{
+	u32 tmp;
+
+	if (!a)
+		return b;
+
+	while (b) {
+		tmp = a % b;
+		a = b;
+		b = tmp;
+	}
+
+	return a;
+}
