+};
+
+static int get_idr(struct idr *idr, int *id)
+{
+    int ret;
+
+    mutex_lock(&devfreq_cooling_lock);
+    ret = idr_alloc(idr, NULL, 0, 0, GFP_KERNEL);
+    mutex_unlock(&devfreq_cooling_lock);
+    if (unlikely(ret < 0))
+        return ret;
+    *id = ret;
+
+    return 0;
+}
+
+static void release_idr(struct idr *idr, int id)
+{
+    mutex_lock(&devfreq_cooling_lock);
+    idr_remove(idr, id);
+    mutex_unlock(&devfreq_cooling_lock);
+}
