+static inline int inst_isactive(struct vsi_v4l2_ctx *ctx)
+{
+	if (ctx->status == DEC_STATUS_DECODING ||
+		ctx->status == DEC_STATUS_DRAINING ||
+		ctx->status == ENC_STATUS_ENCODING ||
+		ctx->status == ENC_STATUS_DRAINING)
+		return 1;
+	return 0;
+}
