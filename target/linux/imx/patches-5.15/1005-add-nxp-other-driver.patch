+static struct file_operations hantroenc_fops = {
+	.owner = THIS_MODULE,
+	.open = hantroenc_open,
+	.release = hantroenc_release,
+	.unlocked_ioctl = hantroenc_ioctl,
+	.fasync = NULL,
