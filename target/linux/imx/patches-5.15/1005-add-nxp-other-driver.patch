+static ssize_t v4l2_msg_read(struct file *fh, char __user *buf, size_t size, loff_t *offest)
+{
+	int ret, r;
+
+	ret = wait_event_interruptible_timeout(cmd_queue, ((r = getMsg(fh, buf, size)) != 0), msecs_to_jiffies(100));
+	if (ret == -ERESTARTSYS)
+		return -EIO;
+	else if (ret == 0)
+		return 0;
+	return r;
+}
