+			" %d:active,", VB2_BUF_STATE_ACTIVE);
+	num += scnprintf(buf + num, size - num,
+			" %d:done,", VB2_BUF_STATE_DONE);
+	num += scnprintf(buf + num, size - num,
+			" %d:error", VB2_BUF_STATE_ERROR);
