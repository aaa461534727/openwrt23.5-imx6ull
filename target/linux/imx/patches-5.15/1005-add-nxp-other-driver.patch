+static gctUINT32
+CalcDelta(
+    IN gctUINT32 newval,
+    IN gctUINT32 oldval
+    )
+{
+    if (newval >= oldval)
+    {
+        return newval - oldval;
+    }
+    else
+    {
+        return (gctUINT32)((gctUINT64)newval + 0x100000000ll - oldval);
+    }
+}
