+static void vpu_dec_cleanup_event(struct vpu_ctx *ctx)
+{
+	struct v4l2_event ev;
+	int ret;
+
+	while (v4l2_event_pending(&ctx->fh)) {
+		ret = v4l2_event_dequeue(&ctx->fh, &ev, 1);
