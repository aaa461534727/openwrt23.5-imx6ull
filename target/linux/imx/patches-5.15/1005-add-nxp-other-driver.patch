+static bool check_is_need_reset_after_abort(struct vpu_ctx *ctx)
+{
+	if (!ctx)
+		return false;
+	if (ctx->b_firstseq)
+		return true;
+	if (!ctx->frame_decoded)
+		return true;
+
+	return false;
+}
