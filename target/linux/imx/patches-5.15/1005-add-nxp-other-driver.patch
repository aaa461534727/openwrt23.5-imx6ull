+static long ReservePostProcessor(hantrodec_t *dev, struct file *filp)
+{
+	unsigned long flags;
+
+	long Core = 0;
+
+	/* single Core PP only */
+	if (down_interruptible(&dev->pp_core_sem))
+		return -ERESTARTSYS;
+
+	spin_lock_irqsave(&owner_lock, flags);
+
+	dev->pp_owner = filp;
+
+	spin_unlock_irqrestore(&owner_lock, flags);
+
