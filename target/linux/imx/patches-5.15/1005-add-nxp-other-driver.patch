+		if (test_bit(VPU_ENC_STATUS_HANG, &ctx->status))
+			num += scnprintf(buf + num, size - num, "<hang>\n");
+	} else {
+		num += scnprintf(buf + num, size - num,
+			"<instance has been released>\n");
