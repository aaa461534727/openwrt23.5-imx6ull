+    /* stlb physical address. */
+    gctPHYS_ADDR_T              stlbPhysical;
+
+    /* Free entries. */
+    gctUINT32                   heapList;
+    gctBOOL                     freeNodes;
+
+    gceAREA_TYPE                areaType;
+
+    gctUINT32                   mappingStart;
+    gctUINT32                   mappingEnd;
+
+    gctUINT32_PTR               mapLogical;
+}
