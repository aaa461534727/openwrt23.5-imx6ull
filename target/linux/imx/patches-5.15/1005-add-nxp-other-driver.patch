+static struct vpu_v4l2_fmt *find_fmt_by_fourcc(struct vpu_v4l2_fmt *fmts,
+						unsigned int size,
+						u32 fourcc)
+{
+	unsigned int i;
+
+	if (!fmts || !size)
+		return NULL;
+
+	for (i = 0; i < size; i++) {
+		if (fmts[i].fourcc == fourcc)
+			return &fmts[i];
+	}
+
+	return NULL;
+}
