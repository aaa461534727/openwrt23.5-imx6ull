+static char *cvrt_fourcc_to_str(u32 pixelformat)
+{
+	static char str[5];
+
+	str[0] = pixelformat & 0xff;
+	str[1] = (pixelformat >> 8) & 0xff;
+	str[2] = (pixelformat >> 16) & 0xff;
+	str[3] = (pixelformat >> 24) & 0xff;
+	str[4] = '\0';
+
+	return str;
+}
