+static bool vpu_dec_is_active(struct vpu_ctx *ctx)
+{
+	bool status = true;
+
+	if (!ctx)
+		return false;
+	if (ctx->firmware_stopped)
+		return false;
+	mutex_lock(&ctx->cmd_lock);
+	if (ctx->pending && ctx->pending->request == VID_API_CMD_STOP)
+		status = false;
+	mutex_unlock(&ctx->cmd_lock);
+
+	return status;
+}
